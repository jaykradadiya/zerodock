{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeroDock",
  "version": "0.1.0",
  "identifier": "com.zerodock.app",
  "build": {
    "beforeDevCommand": "dx serve --platform desktop --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "dx bundle --platform desktop",
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "windows": [
      {
        "title": "ZeroDock",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../app/assets/favicon.svg"]
  },
  "plugins": {
    "dialog": {},
    "fs": {
      "scope": ["$APPDATA/**", "$DOCUMENT/**", "$DOWNLOAD/**"]
    },
    "shell": {
      "open": true
    }
  }
}
